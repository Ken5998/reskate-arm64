Date: Sun, 18 Oct 2026 11:30:12 +0000
Subject: [PATCH] fix(memory): read without faulting under Wine

---
 Engine/Core/Platform/memory.h | 54 +++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/Engine/Core/Platform/memory.h b/Engine/Core/Platform/memory.h
index 403a642..39fab6d 100644
--- a/Engine/Core/Platform/memory.h
+++ b/Engine/Core/Platform/memory.h
@@ -7,9 +7,60 @@
 
 namespace dingosdk::memory {
 inline constexpr std::uintptr_t highest_user_address = 0x00007fffffffffffULL;
+
+// Under Wine on ARM64 with FEX, a read that faults is what ends the game: a caught access
+// violation can unwind to the wrong frame, and ReadProcessMemory's own fault handling on the
+// Unix side can fail the same way. There the reads below first check the pages with
+// VirtualQuery and copy only committed, readable memory, so a bad address never faults.
+// RESKATE_PEEK_EXCEPTIONS=1 turns this off.
+inline bool check_pages_first() noexcept {
+    static const bool value = [] {
+        char flag[2]{};
+        if (GetEnvironmentVariableA("RESKATE_PEEK_EXCEPTIONS", flag, sizeof(flag)) == 1 && flag[0] == '1') return false;
+        const auto ntdll = GetModuleHandleW(L"ntdll.dll");
+        return ntdll && GetProcAddress(ntdll, "wine_get_version");
+    }();
+    return value;
+}
+// VirtualQuery is a system call, and under FEX a slow one, while peek runs on paths that read
+// game objects every frame. Each thread keeps the last few readable regions it found for a
+// quarter of a second, so most reads skip the query.
+struct ReadableRegion { std::uintptr_t begin, end; std::uint64_t checked_at; };
+inline thread_local ReadableRegion readable_regions[8]{};
+inline thread_local unsigned next_readable_region{};
+inline bool readable_range(std::uintptr_t address, std::size_t size) noexcept {
+    const auto now = GetTickCount64();
+    const auto end = address + size;
+    for (const auto& region : readable_regions)
+        if (region.begin <= address && end <= region.end && now - region.checked_at < 250) return true;
+    while (address < end) {
+        MEMORY_BASIC_INFORMATION region{};
+        if (!VirtualQuery(reinterpret_cast<const void*>(address), &region, sizeof(region)) || region.State != MEM_COMMIT ||
+            (region.Protect & (PAGE_GUARD | PAGE_NOACCESS))) return false;
+        const auto protection = region.Protect & 0xff;
+        if (protection != PAGE_READONLY && protection != PAGE_READWRITE && protection != PAGE_WRITECOPY &&
+            protection != PAGE_EXECUTE_READ && protection != PAGE_EXECUTE_READWRITE && protection != PAGE_EXECUTE_WRITECOPY)
+            return false;
+        const auto begin = reinterpret_cast<std::uintptr_t>(region.BaseAddress);
+        address = begin + region.RegionSize;
+        readable_regions[next_readable_region++ % 8] = {begin, address, now};
+    }
+    return true;
+}
+inline bool copy_if_readable(std::uintptr_t address, void* destination, std::size_t size) noexcept {
+    if (!readable_range(address, size)) return false;
+    __try {
+        std::memcpy(destination, reinterpret_cast<const void*>(address), size);
+        return true;
+    } __except (EXCEPTION_EXECUTE_HANDLER) {
+        return false;
+    }
+}
+
 inline bool read_bytes(std::uintptr_t address, void* destination, std::size_t size) noexcept {
     if (!destination || !size || size > highest_user_address || address < 0x10000 ||
         address > highest_user_address - size) return false;
+    if (check_pages_first()) return copy_if_readable(address, destination, size);
     SIZE_T count{};
     return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(address), destination, size, &count) && count == size;
 }
@@ -23,6 +74,7 @@ bool read(std::uintptr_t address, T& value) noexcept { return read_bytes(address
 inline bool peek_bytes(std::uintptr_t address, void* destination, std::size_t size) noexcept {
     if (!destination || !size || size > highest_user_address || address < 0x10000 ||
         address > highest_user_address - size) return false;
+    if (check_pages_first()) return copy_if_readable(address, destination, size);
     __try {
         std::memcpy(destination, reinterpret_cast<const void*>(address), size);
         return true;
@@ -65,9 +117,11 @@ inline void* allocate_near_image(std::uintptr_t base, std::size_t image_size, st
 // touches memory past the terminator.
 inline std::ptrdiff_t peek_cstring(std::uintptr_t address, char* destination, std::size_t capacity) noexcept {
     if (!destination || !capacity || address < 0x10000 || address > highest_user_address - capacity) return -1;
+    const bool check = check_pages_first();
     __try {
         const auto* source = reinterpret_cast<const char*>(address);
         for (std::size_t i = 0; i < capacity; ++i) {
+            if (check && (i == 0 || ((address + i) & 0xfff) == 0) && !readable_range(address + i, 1)) return -1;
             destination[i] = source[i];
             if (destination[i] == '\0') return static_cast<std::ptrdiff_t>(i);
         }
